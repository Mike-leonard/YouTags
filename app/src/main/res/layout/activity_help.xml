<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:supportsRtl="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/unitads">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STEP 1:"
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="@color/colorSecondary"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15dp"
                android:text="Hashtags: They are tags with the # hash symbol usually present above your video title."/>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/st_1"
                android:layout_marginBottom="7dp"
                android:layout_marginTop="7dp"
                android:adjustViewBounds="true"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STEP 2:"
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="@color/colorSecondary"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15dp"
                android:text="Tags: They are more specific and are detailed. They are not written with a # hash symbol.  Moreover, they are added in the option given to you before publishing the video."/>


            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/st_2"
                android:layout_marginBottom="7dp"
                android:layout_marginTop="7dp"
                android:adjustViewBounds="true"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STEP 3:"
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="@color/colorSecondary"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15dp"
                android:text="Keywords: These are the words that determine what your video is all about. They are present in your Title and also in your Description Box."/>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/st_3"
                android:layout_marginBottom="7dp"
                android:layout_marginTop="7dp"
                android:adjustViewBounds="true"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Things to NOT do in Youtube Tags"
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="@color/colorAccent"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1.Do not over the tag."
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/colorSecondary"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15dp"
                android:text="You must only use around 3 hashtags. If you have been using more than that, then the Youtube algorithm ignores your videos. As for tags recommended is to use around 5 – 8 tags in your description."/>
             <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Never use unrelated tags even once."
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/colorSecondary"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15dp"
                android:text="Imagine you are a cooking channel. And you saw a new trend, it feels like we use it. We also can go trending. But do not use it unless it is directly related. If you do so, the Youtube algorithm catches that. And will immediately stop promoting your videos. If you have already done something like that, do check it out. And remove it."/>
             <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Do not use tags that are illegal."
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/colorSecondary"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15dp"
                android:text="You should not use any sexual or illicit words as tags. You can check out more info from Youtube on that. But the basic rule of thumb is to use those words only which a platform can promote without any tensions."/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. Do not use space in your Hashtags. Do not use tags that are illegal."
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/colorSecondary"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15dp"
                android:text="Your hashtags must be without any space. Even if it is a two word like ‘Cute Cats’, you must use the ‘CuteCats’ hashtag only. This is a big mistake many YouTubers make. Do not have any kinds of spaces in your hashtags even if it is a phrase."/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Things to DO in Youtube Hashtags:"
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="@color/colorAccent"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Use a Simple and Unique personal Hashtags and Tags"
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/colorSecondary"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15dp"
                android:text="All the new channels which blew up have done this. And they say this was one of the ways they blew up. Make sure your name is short and catchy. Moreover, use that name in all of your videos. Type it out in ‘Youtube Search’ to find out if it already represents any other brands."/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Use Tags in Description, Title, Video itself."
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/colorSecondary"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15dp"
                android:text="Choose one target keyword like a long keyword. And put that in the title. Also, say that same keyword in the video itself. Youtube can understand what is said in your videos. So make sure to add your keywords there."/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. After personal, use broad Tags."
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/colorSecondary"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15dp"
                android:text="Broad hashtags can be easily searched in the official KeywordTool.io website. Type in your niche related words and you can find hashtags. Use those hashtags that are relevant to your videos."/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4.Then use alternative Tags."
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/colorSecondary"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15dp"
                android:text="You need to use some tags that are related to your channel directly. 2 tags are more than enough for alternative tags."/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tools to help you find more Good Keywords"
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="@color/colorAccent"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1.Keywords Everywhere Chrome Extension"
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/colorSecondary"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15dp"
                android:text="It shows you list of keywords when you search for something. I searched for ‘tech reviews’ and this is what i got. You can get good idea for Hashtags from here."/>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/st_star"
                android:layout_marginBottom="7dp"
                android:layout_marginTop="7dp"
                android:adjustViewBounds="true"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. VidIQ Chrome Extension"
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/colorSecondary"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15dp"
                android:text="Vid Iq is a power extension and can help your channel grow by providing you a keyword score. It helps determine your keywords value."/>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/st_star_r"
                android:layout_marginBottom="7dp"
                android:layout_marginTop="7dp"
                android:adjustViewBounds="true"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3.TubeBuddy Chrome Extension"
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/colorSecondary"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15dp"
                android:text="Broad hashtags can be easily searched in the official KeywordTool.io website. Type in your niche related words and you can find hashtags. Use those hashtags that are relevant to your videos."/>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/st_star_x"
                android:layout_marginBottom="7dp"
                android:layout_marginTop="7dp"
                android:adjustViewBounds="true"/>

            <Button
                android:id="@+id/main_pager"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="See Tags"
                android:background="@color/colorPrimary"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:visibility="gone"
                android:layout_gravity="center_horizontal"/>

        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/unitads"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="vertical" >
    </LinearLayout>
</RelativeLayout>
